  CONSTRAINT pk_categoria_entrada PRIMARY KEY (id_evento, num_categoria),
  CONSTRAINT fk_categoria_evento FOREIGN KEY (id_evento) REFERENCES evento (id_evento) ON DELETE CASCADE,
